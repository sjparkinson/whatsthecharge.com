<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><%= page_title %></title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", media: "all" %>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔌</text></svg>">

    <% if content_for? :head %>
    <%= yield :head %>
    <% end %>
  </head>
  <body class="bg-light">
    <a id="skip-to-content" class="visually-hidden-focusable bg-info text-body" href="#content">Skip to main content</a>

    <nav class="navbar navbar-expand-md navbar-dark bg-dark">
      <div class="container-fluid">
        <%= link_to "What's the charge?", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbar" aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbar">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    <%= link_to "Charging networks", networks_path(countryCode: @country.countryCode), class: "nav-link" %>
                </li>
            </ul>
            <ul class="navbar-nav">
                <% if @countries.present? -%>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="country-dropdown" role="button" data-toggle="dropdown" aria-expanded="false">
                        <%= @country.name %>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="country-dropdown">
                        <li><h6 class="dropdown-header">Select a country</h6></li>
                        <% @countries.each do |country| -%>
                        <li><%= link_to country.name, country_path(countryCode: country.countryCode), class: "dropdown-item #{'active' if current_page?(countryCode: country.countryCode)}" %>
                        <%- end %>
                    </ul>
                </li>
                <%- end %>
            </ul>
        </div>
        </div>
      </div>
    </nav>

    <main id="content" role="main" class="bg-white py-5">
        <div class="container">
            <%= yield %>
        </div>
    </main>

    <footer class="border-top text-muted py-5">
        <div class="container">
            <p>Built and maintained by <a href="mailto:samuel.parkinson@hey.com">Samuel Parkinson</a> as a small side project.</p>
        </div>
    </footer>

    <%= javascript_pack_tag "application" %>
  </body>
</html>
