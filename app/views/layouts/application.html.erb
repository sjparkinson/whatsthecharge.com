<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><%= page_title %></title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", media: "all" %>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔌</text></svg>">

    <% if content_for? :head %>
    <%= yield :head %>
    <% end %>
  </head>
  <body>
    <a id="skip-to-content" class="visually-hidden-focusable bg-info text-body" href="#content">Skip to main content</a>

    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
      <div class="container-fluid">
        <%= link_to "What's the charge?", root_path, class: "navbar-brand" %>
        <ul class="navbar-nav mr-auto">
          <li class="nav-item">
            <%= link_to "Charging networks", networks_path(countryCode: 'uk'), class: "nav-link" %>
          </li>
        </ul>
        <% if logged_in? -%>
        <div class="navbar-nav">
            <%= link_to "Logout", logout_path, method: :delete, class: "nav-link" %>
        </div>
        <%- end %>
        </div>
      </div>
    </nav>

    <main id="content" role="main" class="container">
        <%= yield %>
    </main>

    <% if Rails.env.development? -%>
    <div class="container border rounded mt-5 pt-3">
        <%= debug(params) %>
    </div>
    <%- end %>

    <%= javascript_pack_tag "application" %>
  </body>
</html>
