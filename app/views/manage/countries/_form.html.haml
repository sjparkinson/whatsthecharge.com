- if @country.errors.any?
  .alert.alert-danger{role: "alert"}
    %ul.mb-0
      - @country.errors.full_messages.each do |error|
        %li= error

= form_with model: [:manage, @country], local: true do |form|

  .mb-3
    = form.label :name, class: 'form-label'
    = form.text_field :name, required: true, class: 'form-control', list: 'country_name_datalist', autocomplete: 'off'
    %datalist#country_name_datalist
      - ISO3166::Country.all_names_with_codes.each do |country|
        %option{value: country[0]}

  .mb-3
    = form.label :countryCode, class: 'form-label'
    = form.text_field :countryCode, required: true, class: 'form-control', 'aria-describedby': 'country_countryCode_help', list: 'country_countryCode_datalist', autocomplete: 'off'
    .form-text#country_countryCode_help Should be a lowercase two letter <a href="https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2">ISO 3166-1 alpha-2 country code</a>.
    %datalist#country_countryCode_datalist
      - ISO3166::Country.all_names_with_codes.each do |country|
        %option{value: country[1].downcase}

  .mb-3
    = form.submit class: 'btn btn-primary'
