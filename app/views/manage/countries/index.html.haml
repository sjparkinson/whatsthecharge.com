= render 'nav'

= page_heading Country.model_name.human(count: 2)

%p.mb-3 Countries can be deleted if they have no networks.

.table-responsive
  %table.table
    %thead
      %tr
        %th{scope: "col"} #
        %th{scope: "col"}= t :name, scope: [:activerecord, :attributes, :country]
        %th{scope: "col"}= t :countryCode, scope: [:activerecord, :attributes, :country]
        %th{scope: "col"}= "Number of #{Network.model_name.human(count: 2)}"
        %th{scope: "col"}
          .visually-hidden Links

    %tbody
      - @countries.each_with_index do |country, index|
        %tr
          %td= index + 1
          %td= country.name
          %td
            %code= country.countryCode
          %td= country.networks.size
          %td.text-right
            = link_to 'Update', [:edit, :manage, country]
            - if country.networks.none?
              = link_to 'Remove', [:manage, country], method: 'delete', class: 'link-danger disabled', data: { confirm: "Are you sure?" }

%p= link_to 'Add a country', new_manage_country_path, class: "btn btn-primary"
