- if @payg_plan_cost.errors.any?
  .alert.alert-danger{role: "alert"}
    %ul.mb-0
      - @payg_plan_cost.errors.full_messages.each do |error|
        %li= error

= form_with model: [:manage, @payg_plan, @payg_plan_cost], local: true do |form|

  .row.mb-3.g-3
    .col-3
      = form.label :cost_per_kwh_currency
      = form.select :cost_per_kwh_currency, [["GBP", "GBP"], ["EUR", "EUR"]], { prompt: true }
    .col
      = form.label :cost_per_kwh
      = form.number_field :cost_per_kwh, min: 0, step: 0.01

  .row.mb-3.g-3
    .col-3
      = form.label :cost_per_minute_currency
      = form.select :cost_per_minute_currency, [["GBP", "GBP"], ["EUR", "EUR"]], { prompt: true }
    .col
      = form.label :cost_per_minute
      = form.number_field :cost_per_minute, min: 0, step: 0.01

  .mb-3
    = form.label :ended_at
    = form.date_field :ended_at, 'aria-describedby': 'payg_plan_cost_ended_at_help'
    .form-text#payg_plan_cost_ended_at_help When this PAYG plan cost stopped being available. Optional.

  .mb-3
    = form.submit class: 'btn btn-primary'
