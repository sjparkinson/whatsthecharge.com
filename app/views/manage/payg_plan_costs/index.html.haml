= render 'nav'

= page_heading "#{PaygPlanCost.model_name.human(count: 2)} for #{@payg_plan.name} (#{@payg_plan.network.name})"

.table-responsive
  %table.table
    %thead
      %tr
        %th{scope: "col"} #
        %th{scope: "col"}= t :cost_per_kwh, scope: [:activerecord, :attributes, :payg_plan_cost]
        %th{scope: "col"}= t :cost_per_minute, scope: [:activerecord, :attributes, :payg_plan_cost]
        %th{scope: "col"}= t :ended_at, scope: [:activerecord, :attributes, :payg_plan_cost]
        %th{scope: "col"}
          .visually-hidden Links

    %tbody
      - @payg_plan_costs.each_with_index do |cost, index|
        %tr
          %td= index + 1
          %td= cost.cost_per_kwh
          %td= cost.cost_per_minute
          %td= cost.ended_at
          %td.text-right
            = link_to 'Update', [:edit, :manage, cost]
            = link_to 'Remove', [:manage, cost], method: 'delete', class: 'link-danger', data: { confirm: "Are you sure?" }

%p= link_to "Add a #{PaygPlanCost.model_name.human}", new_manage_payg_plan_cost_path, class: "btn btn-primary"
