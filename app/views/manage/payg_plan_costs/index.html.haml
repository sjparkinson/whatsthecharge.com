= render 'nav'

= page_heading PaygPlanCost.model_name.human(count: 2)

.table-responsive
  %table.table
    %thead
      %tr
        %th{scope: "col"} #
        %th{scope: "col"}= t :name, scope: [:activerecord, :attributes, :payg_plan_costs]
        %th{scope: "col"}= t :network, scope: [:activerecord, :attributes, :payg_plan_costs]
        %th{scope: "col"}
          .visually-hidden Links

    %tbody
      - @plans.each_with_index do |plan, index|
        %tr
          %td= index + 1
          %td= plan.name
          %td= plan.network.name
          %td.text-right
            = link_to 'Costs', manage_payg_plan_costs_path(plan)
            = link_to 'Update', [:edit, :manage, plan]
            = link_to 'Remove', [:manage, plan], method: 'delete', class: 'link-danger', data: { confirm: "Are you sure?" }

%p= link_to "Add a #{PaygPlan.model_name.human}", new_manage_payg_plan_path, class: "btn btn-primary"
