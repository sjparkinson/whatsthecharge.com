- if @network.errors.any?
  .alert.alert-danger{role: "alert"}
    %ul.mb-0
      - @network.errors.full_messages.each do |error|
        %li= error

= form_with model: [:manage, @network], local: true do |form|

  .mb-3
    = form.label :name
    = form.text_field :name, required: true

  .mb-3
    = form.label :description
    = form.text_area :description, required: true

  .mb-3
    = form.label :slug
    .input-group
      %span.input-group-text <code>/:country/networks/</code>
      = form.text_field :slug, required: true, 'aria-describedby': 'network_slug_help'
    .form-text#network_slug_help Used to generate a human friendly URL for this network, e.g. <code>/uk/networks/<b>ubitricity</b></code>.

  .mb-3
    = form.label :website_url
    = form.url_field :website_url, required: true

  .mb-3
    = form.label :pricing_url
    = form.url_field :pricing_url, 'aria-describedby': 'network_pricing_url_help'
    .form-text#network_pricing_url_help Optional.

  .mb-3
    = form.label :android_app_url
    = form.url_field :android_app_url, 'aria-describedby': 'network_android_app_url_help'
    .form-text#network_android_app_url_help e.g. <code>https://play.google.com/store/apps/details?id=com.ubitricity</code>. Optional.

  .mb-3
    = form.label :ios_app_url
    = form.url_field :ios_app_url, 'aria-describedby': 'network_ios_app_url_help'
    .form-text#network_ios_app_url_help e.g. <code>https://apps.apple.com/gb/app/ubitricity/id1031238194</code>. Optional.

  .mb-3
    = form.label :country_id
    = form.collection_select :country_id, Country.all, :id, :name, { prompt: true }, { required: true }

  .mb-3
    = form.submit class: 'btn btn-primary'
