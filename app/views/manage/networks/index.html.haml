= render 'nav'

= page_heading Network.model_name.human(count: 2)

.table-responsive
  %table.table
    %thead
      %tr
        %th{scope: "col"} #
        %th{scope: "col"}= t :name, scope: [:activerecord, :attributes, :network]
        %th{scope: "col"}= t :country, scope: [:activerecord, :attributes, :network]
        %th{scope: "col"}
          .visually-hidden Links

    %tbody
      - @networks.each_with_index do |network, index|
        %tr
          %td= index + 1
          %td= network.name
          %td= network.country.name
          %td.text-right
            = link_to 'Update', [:edit, :manage, network]
            = link_to 'Remove', [:manage, network], method: 'delete', class: 'link-danger', data: { confirm: "Are you sure?" }

%p= link_to 'Add a Network', new_manage_network_path, class: "btn btn-primary"
