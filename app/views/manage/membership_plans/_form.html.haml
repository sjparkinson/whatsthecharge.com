- if @membership_plan.errors.any?
  .alert.alert-danger{role: "alert"}
    %ul.mb-0
      - @membership_plan.errors.full_messages.each do |error|
        %li= error

= form_with model: [:manage, @membership_plan], local: true do |form|

  .mb-3
    = form.label :name, class: 'form-label'
    = form.text_field :name, required: true, class: 'form-control'

  .mb-3
    = form.label :description, class: 'form-label'
    = form.text_area :description, required: true, class: 'form-control'

  .row.mb-3.g-3
    .col-3
      = form.label :cost_currency, class: 'form-label'
      = form.select :cost_currency, [["GBP", "GBP"], ["EUR", "EUR"]], { prompt: true }, { required: true, class: "form-select" }
    .col
      = form.label :cost, class: 'form-label'
      = form.number_field :cost, min: 0, step: 0.01, required: true, class: 'form-control'

  .mb-3
    = form.label :cost_frequency, class: 'form-label'
    = form.select :cost_frequency, MembershipPlan.cost_frequencies.keys.collect { |frequency| [MembershipPlan.human_attribute_name("cost_frequencies.#{frequency}"), frequency]}, { prompt: true }, { required: true, class: "form-select" }

  .mb-3
    = form.label :network_id, class: 'form-label'
    = form.grouped_collection_select :network_id, Country.all, :networks, :name, :id, :name, { prompt: true }, { required: true, class: "form-select" }

  .mb-3
    = form.label :plan_url, class: 'form-label'
    = form.url_field :plan_url, class: 'form-control', 'aria-describedby': 'membership_plan_plan_url_help'
    .form-text#membership_plan_plan_url_help Optional.

  .mb-3
    = form.label :ended_at, class: 'form-label'
    = form.date_field :ended_at, class: 'form-control', 'aria-describedby': 'membership_plan_ended_at_help'
    .form-text#membership_plan_ended_at_help When this membership plan stopped being available. Optional.

  .mb-3
    = form.submit class: 'btn btn-primary'
