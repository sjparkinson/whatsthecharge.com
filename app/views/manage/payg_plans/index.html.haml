= render 'nav'

= page_heading PaygPlan.model_name.human(count: 2)

.table-responsive
  %table.table
    %thead
      %tr
        %th{scope: "col"} #
        %th{scope: "col"}= t :name, scope: [:activerecord, :attributes, :payg_plan]
        %th{scope: "col"}= t :network, scope: [:activerecord, :attributes, :payg_plan]
        %th{scope: "col"}
          .visually-hidden Links

    %tbody
      - @payg_plans.each_with_index do |payg_plan, index|
        %tr
          %td= index + 1
          %td= payg_plan.name
          %td= payg_plan.network.name
          %td.text-right
            = link_to 'Update', edit_manage_payg_plan_path(payg_plan)
            = link_to 'Remove', manage_payg_plan_path(payg_plan), method: 'delete', class: 'link-danger', data: { confirm: "Are you sure?" }

%p= link_to "Add a #{PaygPlan.model_name.human}", new_manage_payg_plan_path, class: "btn btn-primary"
