= render 'nav'

= page_heading "#{@payg_plan.name} by #{@payg_plan.network.name}"

.row.mt-3
  .col-lg-2
    %p.font-weight-bold Description
  .col
    %p= @payg_plan.description

.row
  .col-lg-2
    %p.font-weight-bold Network
  .col
    %p= @payg_plan.network.name

- if @payg_plan.plan_url.present?
  .row
    .col-lg-2
      %p.font-weight-bold Plan URL
    .col
      %p= link_to @payg_plan.plan_url, @payg_plan.plan_url

%h3 Charging Rates

.table-responsive
  %table.table
    %thead
      %tr
        %th{scope: "col"} #
        %th{scope: "col"}= t :price_per_kwh, scope: [:activerecord, :attributes, :charging_rate]
        %th{scope: "col"}= t :price_per_minute, scope: [:activerecord, :attributes, :charging_rate]
        %th{scope: "col"}= t :supported_charging_speeds, scope: [:activerecord, :attributes, :charging_rate]
        %th{scope: "col"}= t :ended_at, scope: [:activerecord, :attributes, :charging_rate]
        %th{scope: "col"}
          .visually-hidden Links

    %tbody
      %tr
        %td 1
        %td £0.34
        %td
        %td 7, 11, 22
        %td
        %td.text-right
          = link_to 'Update', "#"
          = link_to 'Remove', "#", method: 'delete', class: 'link-danger', data: { confirm: "Are you sure?" }

%p= link_to "Add a Charging Rate", "#", class: 'btn btn-primary'
