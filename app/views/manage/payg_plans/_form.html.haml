- if @payg_plan.errors.any?
  .alert.alert-danger{role: "alert"}
    %ul.mb-0
      - @payg_plan.errors.full_messages.each do |error|
        %li= error

= form_with model: [:manage, @payg_plan], local: true do |form|

  .mb-3
    = form.label :name, class: 'form-label'
    = form.text_field :name, class: 'form-control'

  .mb-3
    = form.label :description, class: 'form-label'
    = form.text_area :description, class: 'form-control'

  .mb-3
    = form.label :network_id, class: 'form-label'
    = form.collection_select :network_id, Network.all, :id, :name, { prompt: true }, { class: "form-select" }

  .mb-3
    = form.label :started_at, class: 'form-label'
    = form.date_field :started_at, class: 'form-control'

  .mb-3
    = form.label :ended_at, class: 'form-label'
    = form.date_field :ended_at, class: 'form-control'

  .mb-3
    = form.submit class: 'btn btn-primary'
