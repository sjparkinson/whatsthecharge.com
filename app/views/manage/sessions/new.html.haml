= page_heading "Login"

= form_with url: login_path, scope: :session, local: true do |form|

  .mb-3
    = form.label :email
    = form.email_field :email, required: true

  .mb-3
    = form.label :password
    = form.password_field :password, required: true

  .mb-3
    = form.submit "Login", class: 'btn btn-primary'
