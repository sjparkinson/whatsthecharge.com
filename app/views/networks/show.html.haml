= page_heading @network.name

%p= @network.description

%p= link_to "Go to the #{@network.name} website", @network.website_url

.row.align-items-center
  .col-md-6.text-center
    - if @network.android_app_url
      %a{:href => @network.android_app_url}>
        %img{src: "https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png", alt: "Get #{@network.name} on Google Play", width: 230}>

  .col-md-6.text-center
    - if @network.ios_app_url
      %a{href: @network.ios_app_url}>
        %img{src: "https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-US", alt: "Download #{@network.name} on the App Store", width: 180}>
