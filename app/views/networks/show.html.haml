= page_heading @network.name

%p= @network.description

%p= link_to "Go to the #{@network.name} website", @network.website_url

.row.align-items-center.g-3
  .col-md-6.text-center
    - if @network.android_app_url
      %a{:href => @network.android_app_url}>
        = image_tag "play-store-badge.png", width: 250, alt: "Get #{@network.name} on Google Play"

  .col-md-6.text-center
    - if @network.ios_app_url
      %a{href: @network.ios_app_url}>
        = image_tag "app-store-badge.png", width: 220, alt: "Download #{@network.name} on the App Store"


- if @network.membership_plans.size > 0

  %h3.my-3 Subscriptions

  .row.row-cols-1.row-cols-md-2.g-3

    - @network.membership_plans.each do |membership_plan|
      .col
        .card
          .card-body
            %h5.card-title= membership_plan.name
            %p.card-text= membership_plan.description
            %p.card-text= "#{membership_plan.cost_currency} #{membership_plan.cost}"
            %p.card-text= "Subscription frequency is #{MembershipPlan.human_attribute_name("cost_frequencies.#{membership_plan.cost_frequency}").downcase}."
            - if membership_plan.plan_url
              %p.card-link= link_to "See the details", membership_plan.plan_url

