<%= page_heading "Charging networks in the United Kingdom" %>

<p class="lead">There are <%= @networks.length %> charging networks operating in the United Kingdom.</p>

<h3>Nationwide</h3>

<div class="row row-cols-1 row-cols-md-3 g-3">
    <% @networks.each do |network| -%>
    <div class="col">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><%= network.name %></h5>
                <p class="card-text">Foo bar description for the network.</p>
            </div>
        </div>
    </div>
    <%- end %>
</div>
