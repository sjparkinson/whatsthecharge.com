<%= page_heading @network.name %>

<p><%= link_to @network.url, @network.url %></p>

<% if @payg_plans.present? -%>
<h3>Pay-as-you-go plans</h3>

<ul>
    <% @payg_plans.each do |plan| -%>
    <li><%= plan.name %></li>
    <%- end %>
</ul>
<%- end %>

<% if @membership_plans.present? -%>
<h3>Membership plans</h3>

<ul>
    <% @membership_plans.each do |plan| -%>
    <li><%= plan.name %></li>
    <%- end %>
</ul>
<%- end %>
