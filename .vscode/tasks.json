{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "bundle install",
            "type": "shell",
            "command": "source /usr/local/rvm/scripts/rvm; rvm use; bundle install",
            "group": "build"
        },
        {
            "label": "yarn install",
            "type": "shell",
            "command": "yarn install",
            "group": "build"
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "source /usr/local/rvm/scripts/rvm; rvm use; bundle exec rails test",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Install dependencies",
            "dependsOn": ["bundle install", "yarn install"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
